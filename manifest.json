{
  "manifest_version": 3,
  "name": "Cookie Crusher",
  "version": "1.1.0",
  "description": "See the cookies (and trackers) sites just gave you, crush them by hand or automatically when you leave.",
  "permissions": ["cookies", "storage", "tabs", "alarms", "browsingData"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Crusher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
